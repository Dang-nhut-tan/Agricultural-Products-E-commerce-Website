  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status code is 201\",function()\r",
                  "{\r",
                  "    pm.response.to.have.status(201)\r",
                  "})"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const prefix = pm.iterationData.get(\"emailPrefix\") || \"postman.user\";",
                  "const unique = `${Date.now()}.${pm.info.iteration}`;",
                  "pm.variables.set(\"testEmail\", `${prefix}.${unique}@example.com`);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"{{name}}\",\r\n    \"email\": \"{{testEmail}}\",\r\n    \"password\": \"{{password}}\",\r\n    \"passwordConfirmation\": \"{{password}}\",\r\n    \"phone\": \"{{phone}}\",\r\n    \"address\": \"{{address}}\",\r\n    \"ward\": \"{{ward}}\",\r\n    \"district\": \"{{district}}\",\r\n    \"province\": \"{{province}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "get product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has a data array\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"data\");",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Each item in data has required fields: id, name, price, image, Category\", function () {",
                  "    const json = pm.response.json();",
                  "    json.data.forEach(function (item) {",
                  "        pm.expect(item).to.have.property(\"id\");",
                  "        pm.expect(item).to.have.property(\"name\");",
                  "        pm.expect(item).to.have.property(\"price\");",
                  "        pm.expect(item).to.have.property(\"image\");",
                  "        pm.expect(item).to.have.property(\"Category\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Response has a pagination object with fields: page, limit, total, totalPages\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"pagination\");",
                  "    pm.expect(json.pagination).to.have.property(\"page\");",
                  "    pm.expect(json.pagination).to.have.property(\"limit\");",
                  "    pm.expect(json.pagination).to.have.property(\"total\");",
                  "    pm.expect(json.pagination).to.have.property(\"totalPages\");",
                  "});",
                  "",
                  "pm.test(\"pagination.page matches iteration data\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.pagination.page).to.eql(Number(pm.iterationData.get(\"page\") || 1));",
                  "});",
                  "",
                  "pm.test(\"Each product's Category object (if present) has id and name\", function () {",
                  "    const json = pm.response.json();",
                  "    json.data.forEach(function (item) {",
                  "        if (item.Category) {",
                  "            pm.expect(item.Category).to.have.property(\"id\");",
                  "            pm.expect(item.Category).to.have.property(\"name\");",
                  "        }",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 3000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?page={{page}}&search={{search}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "{{page}}"
                },
                {
                  "key": "search",
                  "value": "{{search}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "get product by id",

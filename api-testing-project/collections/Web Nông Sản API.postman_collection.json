    {
      "name": "Products",
      "item": [
        {
          "name": "get product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has a data array\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"data\");",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Each item in data has required fields: id, name, price, image, Category\", function () {",
                  "    const json = pm.response.json();",
                  "    json.data.forEach(function (item) {",
                  "        pm.expect(item).to.have.property(\"id\");",
                  "        pm.expect(item).to.have.property(\"name\");",
                  "        pm.expect(item).to.have.property(\"price\");",
                  "        pm.expect(item).to.have.property(\"image\");",
                  "        pm.expect(item).to.have.property(\"Category\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Response has a pagination object with fields: page, limit, total, totalPages\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"pagination\");",
                  "    pm.expect(json.pagination).to.have.property(\"page\");",
                  "    pm.expect(json.pagination).to.have.property(\"limit\");",
                  "    pm.expect(json.pagination).to.have.property(\"total\");",
                  "    pm.expect(json.pagination).to.have.property(\"totalPages\");",
                  "});",
                  "",
                  "pm.test(\"pagination.page equals 1 (matches query param page=1)\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.pagination.page).to.eql(1);",
                  "});",
                  "",
                  "pm.test(\"Each product's Category object (if present) has id and name\", function () {",
                  "    const json = pm.response.json();",
                  "    json.data.forEach(function (item) {",
                  "        if (item.Category) {",
                  "            pm.expect(item.Category).to.have.property(\"id\");",
                  "            pm.expect(item.Category).to.have.property(\"name\");",
                  "        }",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 3000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  "",
                  "pm.globals.set(\"name\", \"Tan\")",
                  "",
                  "",
                  "// Visualization Script",
                  "// Visualization Script",
                  "const template = `",
                  "<style>",
                  "  * { box-sizing: border-box; }",
                  "  body { font-family: sans-serif; padding: 12px; margin: 0; }",
                  "  h2 { font-size: 15px; margin: 0 0 10px; }",
                  "  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-bottom: 14px; }",
                  "  .card { padding: 10px 14px; border: 1px solid #e0e0e0; border-radius: 6px; }",
                  "  .card .v { font-size: 22px; font-weight: 700; }",
                  "  .card .l { font-size: 11px; color: #888; text-transform: uppercase; margin-top: 2px; }",
                  "  table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 16px; }",
                  "  th { background: #f5f5f5; text-align: left; padding: 6px 8px; border-bottom: 2px solid #ddd; }",
                  "  td { padding: 6px 8px; border-bottom: 1px solid #eee; vertical-align: middle; }",
                  "  .badge { display: inline-block; padding: 2px 7px; border-radius: 10px; font-size: 11px; font-weight: 600; }",
                  "  .in-stock { background: #d1fae5; color: #065f46; }",
                  "  .out-stock { background: #fee2e2; color: #991b1b; }",
                  "  .chart-wrap { max-width: 560px; }",
                  "</style>",
                  "<h2>Product Overview</h2>",
                  "<div class=\"grid\">",
                  "  <div class=\"card\"><div class=\"v\">{{summary.total}}</div><div class=\"l\">Total Products</div></div>",
                  "  <div class=\"card\"><div class=\"v\">{{summary.inStock}}</div><div class=\"l\">In Stock</div></div>",
                  "  <div class=\"card\"><div class=\"v\">{{summary.totalSold}}</div><div class=\"l\">Total Sold</div></div>",
                  "  <div class=\"card\"><div class=\"v\">{{summary.page}} / {{summary.totalPages}}</div><div class=\"l\">Page</div></div>",
                  "</div>",
                  "<table>",
                  "  <tr><th>#</th><th>Name</th><th>Category</th><th>Price (VND)</th><th>Qty</th><th>Sold</th><th>Status</th></tr>",
                  "  {{#each rows}}",
                  "  <tr>",
                  "    <td>{{id}}</td>",
                  "    <td>{{name}}</td>",
                  "    <td>{{category}}</td>",
                  "    <td>{{price}}</td>",
                  "    <td>{{quantity}}</td>",
                  "    <td>{{sold}}</td>",
                  "    <td><span class=\"badge {{stockClass}}\">{{stockLabel}}</span></td>",
                  "  </tr>",
                  "  {{/each}}",
                  "</table>",
                  "<div class=\"chart-wrap\">",
                  "  <canvas id=\"chart\" height=\"120\"></canvas>",
                  "</div>",
                  "<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4\"></script>",
                  "<script>",
                  "  pm.getData(function (err, value) {",
                  "    new Chart(document.getElementById('chart'), {",
                  "      type: 'bar',",
                  "      data: {",
                  "        labels: value.rows.map(function (r) { return r.name; }),",
                  "        datasets: [",
                  "          {",
                  "            label: 'Price (x1000 VND)',",
                  "            data: value.rows.map(function (r) { return r.priceRaw / 1000; }),",
                  "            backgroundColor: 'rgba(99,102,241,0.7)'",
                  "          },",
                  "          {",
                  "            label: 'Sold Count',",
                  "            data: value.rows.map(function (r) { return r.sold; }),",
                  "            backgroundColor: 'rgba(16,185,129,0.7)'",
                  "          }",
                  "        ]",
                  "      },",
                  "      options: {",
                  "        plugins: { legend: { display: true } },",
                  "        scales: { y: { beginAtZero: true } }",
                  "      }",
                  "    });",
                  "  });",
                  "</script>`;",
                  "",
                  "function createPayload() {",
                  "  var body = pm.response.json();",
                  "  var pagination = body.pagination || {};",
                  "  var inStock = body.data.filter(function (p) { return p.quantity > 0; }).length;",
                  "  var totalSold = body.data.reduce(function (acc, p) { return acc + (p.sold_count || 0); }, 0);",
                  "  var rows = body.data.map(function (p) {",
                  "    var priceRaw = parseFloat(p.price) || 0;",
                  "    return {",
                  "      id: p.id,",
                  "      name: p.name,",
                  "      category: p.Category ? p.Category.name : 'N/A',",
                  "      price: priceRaw.toLocaleString('vi-VN'),",
                  "      priceRaw: priceRaw,",
                  "      quantity: p.quantity,",
                  "      sold: p.sold_count || 0,",
                  "      stockClass: p.quantity > 0 ? 'in-stock' : 'out-stock',",
                  "      stockLabel: p.quantity > 0 ? 'In Stock' : 'Out of Stock'",
                  "    };",
                  "  });",
                  "  return {",
                  "    summary: {",
                  "      total: pagination.total || body.data.length,",
                  "      inStock: inStock,",
                  "      totalSold: totalSold,",
                  "      page: pagination.page || 1,",
                  "      totalPages: pagination.totalPages || 1",
                  "    },",
                  "    rows: rows",
                  "  };",
                  "}",
                  "",
                  "pm.visualizer.set(template, createPayload());"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          },

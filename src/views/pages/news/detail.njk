{% extends "base.njk" %}

{% block styles %}<link rel="stylesheet" href="/css/news-detail.css?v=5">{% endblock %}

{% block content %}
<article class="news-detail container">
  <a class="news-back" href="/tin-tuc"><span aria-hidden="true">←</span> Quay lại trang tin tức</a>
  <header class="news-detail-header">
    <div class="news-detail-meta"><span>Kiến thức nông sản</span><time>{{ item.publishedDate }}</time></div>
    <h1>{{ item.title }}</h1>
    <p>Thông tin hữu ích từ Nông Sản Xanh dành cho căn bếp và bữa ăn của gia đình bạn.</p>
  </header>
  {% if item.image %}<figure class="news-detail-cover"><img class="news-detail-image" src="{{ item.image }}" alt="{{ item.title }}"></figure>{% endif %}
  <div class="news-detail-layout">
    <aside class="news-detail-aside"><span>Bài viết từ</span><strong>Nông Sản Xanh</strong><p>Tươi lành mỗi ngày</p></aside>
    <div class="news-detail-content">{{ item.content | safe }}</div>
  </div>
  <footer class="news-detail-footer"><div><span>Bạn vừa đọc</span><strong>{{ item.title }}</strong></div><a href="/tin-tuc">Xem thêm bài viết <span aria-hidden="true">→</span></a></footer>
</article>
{% endblock %}

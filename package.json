{
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@adminjs/sequelize": "^4.1.1",
    "@adminjs/upload": "^4.0.2",
    "adminjs": "^7.8.17",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "express": "4.21.2",
    "express-formidable": "^1.2.0",
    "express-session": "^1.19.0",
    "joi": "^18.2.3",
    "mysql2": "^3.22.6",
    "nodemon": "^3.1.14",
    "nunjucks": "^3.2.4",
    "playwright": "^1.61.1",
    "sanitize-html": "^2.17.6",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "yamljs": "^0.3.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:register": "jest tests/register.test.js",
    "test:e2e": "playwright test",
    "api:test": "newman run \"api-testing-project/collections/Web Nông Sản API.postman_collection.json\" -e \"api-testing-project/environments/web-nong-san-api.postman_environment.json\" -d \"api-testing-project/data/api-test-data.json\"",
    "test:allure": "yarn allure:clean && yarn test --runInBand && yarn test:e2e && yarn allure:generate",
    "test:allure:unit": "yarn allure:clean && yarn test --runInBand && yarn allure:generate",
    "allure:clean": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true});require('fs').rmSync('allure-report',{recursive:true,force:true})\"",
    "allure:generate": "cross-env JAVA_HOME= allure generate allure-results --clean -o allure-report",
    "allure:open": "cross-env JAVA_HOME= allure open allure-report",
    "allure:serve": "cross-env JAVA_HOME= allure serve allure-results",
    "docker:up": "docker compose up -d mysql",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f mysql",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "recipes:index": "python src/scripts/build_recipe_index.py",
    "recipes:index:smoke": "python src/scripts/build_recipe_index.py --reset --max-pages 30"
  },
  "name": "web-nong-san",
  "version": "1.0.0",
  "main": "index.js",
  "jest": {
    "testEnvironment": "allure-jest/node",
    "testEnvironmentOptions": {
      "resultsDir": "allure-results",
      "environmentInfo": {
        "test_layer": "unit",
        "runtime": "Node.js"
      },
      "globalLabels": {
        "framework": "Jest",
        "layer": "unit"
      }
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "clearMocks": true
  },
  "repository": "https://github.com/Dang-nhut-tan/backend-hoi-dan-it.git",
  "author": "Dang Nhut Tan <tan128340@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "allure-commandline": "^2.43.0",
    "allure-jest": "3.10.2",
    "allure-js-commons": "3.10.2",
    "allure-playwright": "^3.10.2",
    "cross-env": "^10.1.0",
    "jest": "^30.0.0",
    "jest-environment-node": "30.4.1",
    "newman": "6.2.2"
  }
}
